---
import SectionHeader from './SectionHeader.astro';
import SectionRoutes from './SectionRoutes.astro';
import { getI18n, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const { profile } = getI18n(lang);
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <SectionRoutes variant={2} tone="signal" />

  <div class="container relative z-10">
    <SectionHeader index="03" label="SKILLS" id="skills-title" title={profile.titles.skills} />

    <div class="grid gap-5 md:grid-cols-2">
      {
        profile.skills.map((s, i) => (
          <article class="card p-7 md:p-8" data-reveal>
            <p class="mono-label">
              <span class="mono-accent">S{i + 1}</span> // SKILL
            </p>
            <h3 class="skill-name">{s.name}</h3>
            <p class="skill-desc">{s.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
